# Copie para .env.local e preencha. NUNCA comite .env.local.
# Também configure estas na Vercel (Project Settings > Environment Variables).

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY é o novo nome da anon key no painel do
# Supabase (Settings > API). O valor é o mesmo; só o nome mudou.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave mestra para assinar tokens de ingresso (Bloco 2).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NÃO use prefixo NEXT_PUBLIC_ — nunca deve chegar ao browser.
INGRESSO_TOKEN_SECRET=
